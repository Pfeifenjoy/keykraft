{
	"name": "keycraft",
	"version": "1.0.0",
	"description": "TypeScript-first DynamoDB library built around single-table design",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "npm run test:lint",
		"test:lint": "npm run test:lint:prettier && npm run test:lint:eslint",
		"test:lint:prettier": "npx prettier --check .",
		"test:lint:eslint": "npx eslint .",
		"format": "npm run format:prettier && npm run format:eslint",
		"format:prettier": "npx prettier --write .",
		"format:eslint": "npx eslint --fix ."
	},
	"workspaces": [
		"packages/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pfeifenjoy/keycraft.git"
	},
	"bugs": {
		"url": "https://github.com/Pfeifenjoy/keycraft/issues"
	},
	"homepage": "https://github.com/Pfeifenjoy/keycraft#readme",
	"devDependencies": {
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.71.2"
	}
}
