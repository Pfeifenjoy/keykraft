{
	"name": "keykraft",
	"version": "1.0.0",
	"description": "TypeScript-first DynamoDB library built around single-table design",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "npx lerna run build",
		"release": "npm test && npm run build",
		"test": "npm run test:lint",
		"test:lint": "npm run test:lint:prettier && npm run test:lint:eslint && npm run test:lint:cspell",
		"test:lint:prettier": "npx prettier --check .",
		"test:lint:eslint": "npx eslint .",
		"test:lint:cspell": "npx cspell .",
		"format": "npm run format:prettier && npm run format:eslint",
		"format:prettier": "npx prettier --write .",
		"format:eslint": "npx eslint --fix ."
	},
	"workspaces": [
		"packages/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pfeifenjoy/keykraft.git"
	},
	"bugs": {
		"url": "https://github.com/Pfeifenjoy/keykraft/issues"
	},
	"homepage": "https://github.com/Pfeifenjoy/keykraft#readme",
	"devDependencies": {
		"cspell": "^10.4.0",
		"eslint": "^10.13.0",
		"lerna": "^10.1.1",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
